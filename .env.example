# Copy to backend/.env and fill in. Never commit the real .env.
# development or production. In production the server refuses to start with the default secrets.
ENVIRONMENT=development
DATABASE_URL=postgresql+psycopg://propconnect:propconnect@localhost:5432/propconnect
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRE_MINUTES=60
CORS_ORIGINS=http://localhost:5173
# Used by the seed script to create the first Administrator/Broker account
ADMIN_EMAIL=admin@propconnect-demo.com
ADMIN_PASSWORD=change-me-now
# Password for the two demo agents created by seed_demo
DEMO_PASSWORD=DemoAgent2026
# AI Next Step. Leave OPENAI_API_KEY blank to use the rule-based fallback.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# Each user can ask the AI this many times per hour (protects the OpenAI bill on the live site)
AI_REQUESTS_PER_HOUR=30
# Automatic emails (optional). Leave BREVO_API_KEY empty and nothing is sent.
BREVO_API_KEY=
EMAIL_FROM_ADDRESS=
EMAIL_FROM_NAME=PropConnect AI
