# Copy to backend/.env and fill in. Never commit the real .env.
DATABASE_URL=postgresql+psycopg://propconnect:propconnect@localhost:5432/propconnect
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRE_MINUTES=60
CORS_ORIGINS=http://localhost:5173
# Used by the seed script to create the first Administrator/Broker account
ADMIN_EMAIL=admin@propconnect-demo.com
ADMIN_PASSWORD=change-me-now
# Phase 5 (AI Lead Assistant) - leave blank until then
OPENAI_API_KEY=
